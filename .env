# Frontend Environment Variables

# VITE_API_BASE is optional.
# If left empty, API calls will be relative (e.g., /api/tours), which works:
# 1. In Development: via Vite proxy (configured in vite.config.ts to read server/.env)
# 2. In Production: if served from the same origin as the backend.
#
# Only set this if your frontend and backend are on different domains/ports in production
# and you are NOT serving the frontend from the backend.
VITE_API_BASE=
